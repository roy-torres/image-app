# Server-side configuration for the api/generate.js proxy.
# These are NOT prefixed with VITE_ and are never bundled into the client.
# In production, set them in the Vercel project's Environment Variables.
# For local dev, copy this file to `.env` (git-ignored) and fill in real values.

# Required: the private n8n webhook the proxy forwards to.
WEBHOOK_URL=https://your-n8n-host/webhook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: if the n8n Webhook node uses Header Auth, the proxy sends this as
# `Authorization: Bearer <secret>`.
# WEBHOOK_SECRET=

# Comma-separated list of origins allowed to call the proxy.
# Include your production domain(s) plus the local dev origin.
ALLOWED_ORIGINS=http://localhost:5173

# Optional: comma-separated host suffixes; any https origin whose host ends with
# one is allowed. Use for Vercel preview deployments (unique hostname each time).
# ALLOWED_ORIGIN_SUFFIXES=-roy-torres-projects.vercel.app

# Optional tuning (defaults shown).
# MAX_FILE_MB=4
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_MS=60000

# Optional: only needed if the proxy is hosted on a different origin than the app.
# VITE_API_ENDPOINT=/api/generate
